# libFuzzer dictionary for race_wasm: the same tokens as race_rust's, the codec it is
# checked against. The RACE framing bytes for decode mode, and the JSON keys and values
# of a saved command for encode mode (config bit 0 on).
# The CI job and `just fuzz` pass fuzz/dicts/<target>.dict when it exists.

sync="\x05"
cmd="\x05\x5a"
rsp="\x05\x5b"
ind="\x05\x5c"
log="\x05\x5d"
not_a_type="\x05\x5e"
sync_sync="\x05\x05"
len_min="\x02\x00"
len_one="\x01\x00"
len_zero="\x00\x00"
len_max="\x00\x10"
len_over="\x01\x10"
len_ffff="\xff\xff"
version_query="\x05\x5a\x02\x00\x15\x0f"
version_rsp="\x05\x5b\x05\x00\x15\x0f\x00\x01\x02"
cmd_version="\x15\x0f"
cr="\x0d"
lf="\x0a"
crlf="\x0d\x0a"
tab="\x09"
backslash="\x5c"
nul="\x00"
high="\xff"

# encode mode
object_open="{"
object_close="}"
list_open="["
list_close="]"
colon=":"
comma=","
k_command="\"command\":"
k_type="\"type\":"
k_cmd_id="\"cmd_id\":"
k_payload="\"payload\":"
v_race="\"race\""
v_race_version="\"race_version\""
v_command="\"command\""
v_response="\"response\""
v_indication="\"indication\""
v_log="\"log\""
v_type_byte="\"0x5D\""
v_cmd_id_hex="\"0x0F15\""
v_cmd_id_big="65536"
v_cmd_id_max="65535"
v_negative="-1"
v_hex_bytes="\"05 5A 00\""
v_hex_prefixed="\"0x05,0x5a\""
v_odd_hex="\"0\""
v_bytes_list="[0,255,256]"
v_null="null"
v_float="1.5"
