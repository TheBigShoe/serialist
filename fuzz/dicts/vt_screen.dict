# libFuzzer dictionary for vt_screen: the escape sequences a terminal emulator gives
# meaning to, so mutations build cursor moves, mode changes and queries rather than
# stumbling on them. The CI job and `just fuzz` pass fuzz/dicts/<target>.dict when it
# exists.

esc="\x1b"
csi="\x1b["
osc="\x1b]"
dcs="\x1bP"
st="\x1b\\"
apc="\x1b_"
c1_csi="\x9b"
c1_osc="\x9d"
bel="\x07"
bs="\x08"
tab="\x09"
lf="\x0a"
vt="\x0b"
ff="\x0c"
cr="\x0d"
crlf="\x0d\x0a"
so="\x0e"
si="\x0f"
can="\x18"
sub="\x1a"
nul="\x00"
del="\x7f"

# Cursor addressing and movement
home="\x1b[H"
cup="\x1b[1;1H"
cup_far="\x1b[999;999H"
cup_semi=";"
cuu="A"
cud="B"
cuf="C"
cub="D"
cnl="E"
cpl="F"
cha="G"
hpa="`"
vpa="d"
hvp="f"
ind="\x1bD"
nel="\x1bE"
ri="\x1bM"
decsc="\x1b7"
decrc="\x1b8"
scosc="\x1b[s"
scorc="\x1b[u"
far="99999"
count_big="65535"

# Erase, insert, delete, scroll
ed="J"
ed_all="\x1b[2J"
ed_saved="\x1b[3J"
ed_above="\x1b[1J"
el="K"
el_all="\x1b[2K"
ech="X"
ich="@"
dch="P"
il="L"
dl="M"
su="S"
sd="T"
rep="b"
decstbm="r"
decstbm_reset="\x1b[r"
decaln="\x1b#8"
ris="\x1bc"
decstr="\x1b[!p"

# Tabs and charsets
hts="\x1bH"
tbc="g"
tbc_all="\x1b[3g"
cht="I"
cbt="Z"
g0_dec="\x1b(0"
g0_us="\x1b(B"
g1_dec="\x1b)0"
ls1="\x1bn"
ls2="\x1bo"

# SGR
sgr_reset="\x1b[0m"
sgr="m"
sgr_bold="\x1b[1m"
sgr_inverse="\x1b[7m"
sgr_fg256="38;5;"
sgr_bg256="48;5;"
sgr_fgrgb="38;2;"
sgr_colon="38:2::"
sgr_underline_style="4:3"
sgr_underline_color="58;5;"
sep=";"
colon=":"

# Modes: standard, DEC private
irm_on="\x1b[4h"
irm_off="\x1b[4l"
lnm_on="\x1b[20h"
decckm_on="\x1b[?1h"
decckm_off="\x1b[?1l"
decom_on="\x1b[?6h"
decom_off="\x1b[?6l"
decawm_on="\x1b[?7h"
decawm_off="\x1b[?7l"
dectcem_off="\x1b[?25l"
dectcem_on="\x1b[?25h"
deccolm="\x1b[?3h"
mouse_1000="\x1b[?1000h"
mouse_1002="\x1b[?1002h"
mouse_1003="\x1b[?1003h"
mouse_1006="\x1b[?1006h"
alt_47="\x1b[?47h"
alt_1047="\x1b[?1047h"
alt_1048="\x1b[?1048h"
alt_1049_on="\x1b[?1049h"
alt_1049_off="\x1b[?1049l"
bracketed_on="\x1b[?2004h"
bracketed_off="\x1b[?2004l"
sync_on="\x1b[?2026h"
sync_off="\x1b[?2026l"
sync_partial="\x1b[?2026"
deckpam="\x1b="
deckpnm="\x1b>"
cursor_style="\x1b[5 q"
cursor_style_reset="\x1b[0 q"
modes_private="?"
set_mode="h"
reset_mode="l"

# Queries the screen answers
da="\x1b[c"
da2="\x1b[>c"
dsr_status="\x1b[5n"
dsr_cursor="\x1b[6n"
text_area_chars="\x1b[18t"
text_area_pixels="\x1b[14t"
title_push="\x1b[22t"
title_pop="\x1b[23t"
decrqm="\x1b[?25$p"
decrqm_ansi="\x1b[4$p"
keyboard_query="\x1b[?u"
keyboard_push="\x1b[>1u"
keyboard_pop="\x1b[<1u"
decrqss="\x1bP$qm\x1b\\"

# OSC: titles, palette, dynamic colors, hyperlinks, clipboard
osc0="\x1b]0;"
osc2="\x1b]2;"
osc4_query="\x1b]4;1;?\x07"
osc4_set="\x1b]4;1;rgb:ff/00/00\x07"
osc10_query="\x1b]10;?\x07"
osc11_query="\x1b]11;?\x1b\\"
osc12_query="\x1b]12;?\x07"
osc104="\x1b]104\x07"
osc8="\x1b]8;;http://x\x1b\\"
osc52_set="\x1b]52;c;aGk=\x07"
osc52_query="\x1b]52;c;?\x07"
osc_title="\x1b]0;title\x07"
osc_empty_title="\x1b]0;\x07"

# UTF-8: wide characters, combining marks, joiners, a split character, invalid bytes
utf8_2="\xc3\xa9"
utf8_3="\xe2\x82\xac"
utf8_4="\xf0\x9f\x98\x80"
wide_cjk="\xe6\x97\xa5"
wide_emoji="\xf0\x9f\x91\xa8"
combining_acute="\xcc\x81"
combining_enclosing="\xe2\x83\x9d"
zwj="\xe2\x80\x8d"
zwsp="\xe2\x80\x8b"
variation="\xef\xb8\x8f"
utf8_lead2="\xc3"
utf8_lead3="\xe2\x82"
utf8_lead4="\xf0\x9f\x98"
invalid="\xff\xfe"
