# libFuzzer dictionary for config_jsonc: JSON and JSONC tokens, then the key names and
# values the settings, theme, keymap and saved-commands loaders give meaning to, so
# mutations build documents that get past the syntax and into the typed readers.
# The CI job and `just fuzz` pass fuzz/dicts/<target>.dict when it exists.

# JSON and JSONC syntax
obj_open="{"
obj_close="}"
arr_open="["
arr_close="]"
colon=":"
comma=","
trailing_comma=",}"
trailing_comma_arr=",]"
double_comma=",,"
string="\"\""
escape_u="\\u00e9"
escape_bad="\\u12"
escape_x="\\x41"
escape_nl="\\n"
line_comment="// "
block_open="/*"
block_close="*/"
crlf="\x0d\x0a"
lone_cr="\x0d"
single_quote="'"
true="true"
false="false"
null="null"
nan="NaN"
inf="Infinity"
neg_inf="-Infinity"
hex_number="0xFF"
plus_number="+1"
bare_point=".5"
exponent="1e400"
big_int="18446744073709551616"
min_int="-9223372036854775808"
zero="0"
bom="\xef\xbb\xbf"
replacement="\xef\xbf\xbd"
nest_arr="[[[[[[[["
nest_obj="{\"a\":{\"a\":{\"a\":"

