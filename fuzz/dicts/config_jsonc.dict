s_devices="\"devices\""
s_match="\"match\""
s_vid="\"vid\""
s_pid="\"pid\""
s_product="\"product\""
s_data_bits="\"data_bits\""
s_parity="\"parity\""
s_stop_bits="\"stop_bits\""
s_flow_control="\"flow_control\""
s_eol="\"eol\""
s_plugin="\"plugin\""
v_standard="\"standard\""
v_comfortable="\"comfortable\""
v_custom="{\"custom\":1.5}"
v_hex_ascii="\"hex_ascii\""
v_crlf="\"crlf\""
v_vt="\"vt\""
v_vid="\"0x0e8d\""

