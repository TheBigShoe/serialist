# libFuzzer dictionary for store_ingest: the escape-sequence and control tokens the parser
# behind the store gives meaning to, so mutations build sequences rather than stumbling on
# them. The CI job and `just fuzz` pass fuzz/dicts/<target>.dict when it exists.

esc="\x1b"
csi="\x1b["
osc="\x1b]"
dcs="\x1bP"
st="\x1b\\"
sos="\x1bX"
pm="\x1b^"
apc="\x1b_"
c1_csi="\x9b"
bel="\x07"
cr="\x0d"
lf="\x0a"
crlf="\x0d\x0a"
bs="\x08"
tab="\x09"
del="\x7f"
nul="\x00"

sgr_reset="\x1b[0m"
sgr_empty="\x1b[m"
sgr="m"
sep=";"
colon=":"
fg256="38;5;"
bg256="48;5;"
fgrgb="38;2;"
bgrgb="48;2;"
fgrgb_colon="38:2:"
bright="91"
bold_ul="1;4"
el="K"
el1="1K"
el2="2K"
cub="D"
cuf="C"
cha="G"
wide_motion="999C"
private="?"
dectcem="?25l"
sync="?2026h"
clear="2J"
title="0;"
hyperlink="8;;"
charset="\x1b(B"

utf8_2="\xc3\xa9"
utf8_3="\xe2\x9c\x93"
utf8_4="\xf0\x9f\x98\x80"
utf8_lead2="\xc3"
utf8_lead3="\xe2\x9c"
utf8_lead4="\xf0\x9f\x98"
invalid="\xff\xfe"
