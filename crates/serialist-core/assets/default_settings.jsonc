// Serialist default settings.
//
// This file is bundled into the binary and is the base layer: every key a settings
// file leaves out takes its value from here. Serialist reads Zed's settings
// vocabulary, so keys you already have in Zed's settings.json work as they are.
//
// Layers, lowest to highest: these defaults, your user settings.json, then a
// project-local .serialist/settings.json. Objects merge key by key; arrays and
// scalars from a higher layer replace the lower one. A `null` unsets an optional key.
{
  // ---- Buffer font: the terminal text ----

  // Font family name. null uses the platform's monospace font: Menlo on macOS, Cascadia
  // Mono on Windows, DejaVu Sans Mono on Linux.
  "buffer_font_family": null,
  // Size in points.
  "buffer_font_size": 15.0,
  // 100 to 900. 400 is regular, 700 is bold.
  "buffer_font_weight": 400,
  // OpenType features by four-letter tag. true/false become 1/0, integers pass through.
  // Example: { "calt": false, "ss01": true, "cv01": 7 }. "calt": false turns ligatures off.
  "buffer_font_features": {},
  // "comfortable" (1.618), "standard" (1.3), a number, or { "custom": 1.5 }.
  "buffer_line_height": "standard",
  // Families tried, in order, for glyphs the main family lacks.
  "buffer_font_fallbacks": [],

  // ---- UI font: panels, tabs and the status line ----

  // Font family name. null uses the system UI font.
  "ui_font_family": null,
  "ui_font_size": 16.0,
  "ui_font_weight": 400,
  "ui_font_features": {},
  "ui_font_fallbacks": [],

  // ---- Terminal overrides ----
  // Any key set here replaces the matching buffer_font_* value for the terminal only.
  // null means "use the buffer value".
  "terminal": {
    "font_family": null,
    "font_size": null,
    "font_weight": null,
    "font_features": null,
    "font_fallbacks": null,
    "line_height": null
  },

  // ---- Theme ----
  // A theme name, or { "mode": "system" | "light" | "dark", "light": name, "dark": name }.
  // "system" follows the operating system appearance. Themes are Zed theme files
  // (schema v0.2.0) in the themes folder next to this file.
  "theme": {
    "mode": "system",
    "light": "Serialist Light",
    "dark": "Serialist Dark"
  },

  // ---- Display ----
  "display": {
    // Timestamp gutter: "off" | "absolute" | "relative" | "delta".
    "timestamps": "off",
    // strftime-style format for absolute timestamps, in the gutter and in text exports.
    "timestamp_format": "%H:%M:%S%.3f",
    // How received bytes are shown: "text" | "hex" | "hex_ascii".
    "view": "text",
    // Bytes per row in the hex views, 1 to 256.
    "hex_bytes_per_row": 16,
    // Render CR, LF and ESC as dim glyphs.
    "show_control_chars": false,
    // Wrap long lines instead of scrolling sideways.
    "wrap": false
  },

  // ---- Sessions ----

  // Upper bound on scrollback memory per session, in bytes (268435456 = 256 MiB).
  "scrollback_budget_bytes": 268435456,
  // Baud rate for a device with no matching profile.
  "default_baud": 115200,
  // What Enter appends when sending: "none" | "cr" | "lf" | "crlf".
  "line_ending": "crlf",
  // Show what you type in the scrollback. In inline mode the text appears as you type
  // it, as a Tx line of its own (Backspace takes the last character back until Enter).
  "local_echo": false,

  // ---- Inline interactive mode ----
  // Inline mode sends every keystroke to the port as it is typed, like picocom.
  "inline": {
    // What Backspace sends: "del" (0x7f, what most terminals and Linux devices expect)
    // or "bs" (0x08, what some bootloaders expect). Ctrl-Backspace sends the other one.
    "backspace": "del",
    // The keystroke that leaves inline mode instead of being sent, in GPUI's keystroke
    // syntax: "ctrl-]", "ctrl-alt-x", "f12". Press it twice quickly to send it to the
    // device. A key that types a character needs ctrl, alt or cmd with it.
    "escape_chord": "ctrl-]",
    // A paste is written in chunks of this many bytes (1 to 1048576)...
    "paste_chunk_bytes": 64,
    // ...this many milliseconds apart (0 to 10000), for bootloaders that drop bytes
    // when they are sent too fast. 0 sends the chunks back to back.
    "paste_chunk_delay_ms": 10
  },

  // ---- Device profiles ----
  // The first profile whose "match" fits a port applies when it is connected. A key a
  // profile leaves out falls back to the global setting.
  //
  // "match" keys, all optional (a profile with none matches every port):
  //   "vid", "pid"     USB ids: a hex string such as "0x0e8d", or a number.
  //   "product", "manufacturer", "serial_number"
  //                    case-insensitive substrings of the port's USB strings.
  //   "path"           the port path exactly, or a prefix of it (there are no globs).
  //
  // A profile may set:
  //   "name"           shown in the Devices panel in place of the USB product string.
  //   "baud"           any positive integer. Without it: default_baud.
  //   "data_bits"      5, 6, 7 or 8 ("five" to "eight" also work). Default 8.
  //   "parity"         "none" | "odd" | "even" | "mark" | "space". Default "none".
  //   "stop_bits"      1 or 2 ("one" and "two" also work). Default 1.
  //   "flow_control"   "none" | "hardware" (RTS/CTS) | "software" (XON/XOFF). Default "none".
  //   "eol"            what Enter appends for this device: "none" | "cr" | "lf" | "crlf".
  //                    Without it: line_ending.
  //   "plugin"         the codec plugin to activate for this device, by the name it
  //                    describes, such as "airoha-race".
  //   "on_connect"     a Lua script to run once the device has connected, as a path
  //                    relative to the scripts folder.
  //
  // Example:
  //   { "match": { "vid": "0x0e8d", "product": "Airoha" },
  //     "baud": 921600, "plugin": "airoha-race", "eol": "crlf" }
  "devices": []
}
