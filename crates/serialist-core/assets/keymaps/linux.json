// Serialist default key bindings for Linux, in Zed's keymap format: a list of sections,
// each with an optional key context and a map of keystrokes to actions. Your keymap.json
// is applied after this one, so its bindings win. Bind a key to null to unbind it.
//
// Plain ctrl chords belong to the device once inline mode sends keystrokes to the port
// (ctrl-s is XOFF), so most bindings here use shifted chords. Pause is the exception at
// plain ctrl-p, which inline mode sends to the device; there it is ctrl-shift-p. So are
// the tab numbers, ctrl-1 to ctrl-9, and ctrl-pageup/ctrl-pagedown, which inline mode
// sends to the device too; there ctrl-shift-[ and ctrl-shift-] switch tabs. ctrl-shift-p
// opens the command palette, except in inline mode, where it is Pause.
//
// In inline mode (TerminalInline) the terminal sends every key it can encode to the
// port, plain ctrl chords included; the bindings in that section are the exceptions,
// which run as actions instead of being sent.
[
  {
    "bindings": {
      "ctrl-q": "serialist::Quit"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-shift-p": "command_palette::Toggle",
      "ctrl-shift-k": "terminal::Clear",
      "ctrl-shift-w": "tabs::CloseTab",
      "ctrl-alt-w": "serial::Disconnect",
      "ctrl-shift-t": "tabs::NewTab",
      "ctrl-shift-]": "tabs::NextTab",
      "ctrl-shift-[": "tabs::PreviousTab",
      "ctrl-pagedown": "tabs::NextTab",
      "ctrl-pageup": "tabs::PreviousTab",
      "ctrl-1": "tabs::ActivateTab1",
      "ctrl-2": "tabs::ActivateTab2",
      "ctrl-3": "tabs::ActivateTab3",
      "ctrl-4": "tabs::ActivateTab4",
      "ctrl-5": "tabs::ActivateTab5",
      "ctrl-6": "tabs::ActivateTab6",
      "ctrl-7": "tabs::ActivateTab7",
      "ctrl-8": "tabs::ActivateTab8",
      "ctrl-9": "tabs::ActivateTab9",
      "ctrl-p": "terminal::Pause",
      "ctrl-shift-s": "terminal::Export",
      "ctrl-shift-r": "terminal::ToggleRecord",
      "ctrl-i": "terminal::ToggleInline"
    }
  },
  {
    "context": "DevicesPanel",
    "bindings": {
      "down": "devices::SelectNext",
      "up": "devices::SelectPrevious",
      "enter": "serial::Connect"
    }
  },
  {
    "context": "CommandsPanel",
    "bindings": {
      "down": "commands::SelectNext",
      "up": "commands::SelectPrevious",
      "enter": "commands::SendSelected"
    }
  },
  {
    "context": "CommandsPanel > Input",
    "bindings": {
      "up": "commands::SelectPrevious",
      "down": "commands::SelectNext"
    }
  },
  {
    "context": "CommandPalette > Input",
    "bindings": {
      "up": "command_palette::SelectPrevious",
      "down": "command_palette::SelectNext"
    }
  },
  {
    "context": "ComposeBar > Input",
    "bindings": {
      "up": "compose::HistoryPrevious",
      "down": "compose::HistoryNext"
    }
  },
  {
    "context": "ComposeBar",
    "bindings": {
      "ctrl-shift-e": "compose::CycleLineEnding",
      "ctrl-alt-s": "compose::SaveAsCommand"
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-shift-c": "terminal::Copy",
      "ctrl-shift-a": "terminal::SelectAll",
      "ctrl-shift-f": "terminal::Search",
      "alt-z": "terminal::ToggleWrap",
      "alt-t": "terminal::CycleTimestamps",
      "alt-h": "terminal::ToggleHexView",
      "alt-v": "terminal::ToggleEmulation",
      "ctrl-alt-i": "terminal::ToggleFrameStats",
      "pageup": "terminal::PageUp",
      "pagedown": "terminal::PageDown",
      "home": "terminal::ScrollToTop",
      "end": "terminal::JumpToBottom",
      "ctrl-home": "terminal::ScrollToTop",
      "ctrl-end": "terminal::JumpToBottom"
    }
  },
  {
    "context": "TerminalInline",
    "bindings": {
      "ctrl-i": "terminal::ToggleInline",
      "ctrl-shift-v": "terminal::Paste",
      "ctrl-shift-c": "terminal::Copy",
      "ctrl-shift-a": "terminal::SelectAll",
      "ctrl-shift-f": "terminal::Search",
      "ctrl-alt-i": "terminal::ToggleFrameStats",
      "shift-pageup": "terminal::PageUp",
      "shift-pagedown": "terminal::PageDown",
      "ctrl-shift-k": "terminal::Clear",
      "ctrl-shift-w": "tabs::CloseTab",
      "ctrl-alt-w": "serial::Disconnect",
      "ctrl-shift-t": "tabs::NewTab",
      "ctrl-shift-]": "tabs::NextTab",
      "ctrl-shift-[": "tabs::PreviousTab",
      "ctrl-shift-p": "terminal::Pause",
      "ctrl-shift-s": "terminal::Export",
      "ctrl-shift-r": "terminal::ToggleRecord"
    }
  },
  {
    "context": "TerminalSearch",
    "bindings": {
      "escape": "terminal::DismissSearch"
    }
  }
]
