// Serialist settings for the bench
{
  "buffer_font_size": 14, // points

  // Profiles are tried in order; the first match wins.
  "devices": [
    /* The dongle: leave this one on 9600 */
    // kept for the lab
    { "name": "Dongle", "match": { "vid": "0x1a86" }, "baud": 9600 },

    // Anything else
    { "name": "Fallback", "match": {}, "baud": 115200 }, // last resort
    // Airoha earbuds on the bench
    { "name": "Earbuds", "match": { "vid": "0x0e8d" }, "baud": 921600 } // fast link
    // new boards go above the fallback
  ],
  // the end of devices
  "display": { "wrap": true }
}
